# Safe template only. Copy to a local .env.<environment> file and replace placeholders.
# Never commit real credentials, API keys, database URLs or mail passwords.

# Application
PORT=5005
NODE_ENV=development
IS_SWAGGER_ENABLED=false
INCLUDE_TESTING_MODULE=false
SEND_INTERNAL_SERVER_ERROR_DETAILS=false
IOC_LOG=false

# PostgreSQL (database must be provisioned separately before starting the app)
POSTGRES_URI=postgresql://app:replace-me@localhost:5432/bloggers_platform_dev

# Reverse proxy: 0 when directly exposed; otherwise set the exact trusted proxy hop count.
TRUST_PROXY_HOPS=0

# Authentication secrets: generate independent, cryptographically random values.
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_EXPIRE_IN=10m
REFRESH_TOKEN_EXPIRE_IN=30d

# Super-admin Basic Auth credentials (no built-in defaults exist).
SA_LOGIN=replace-me
SA_PASS=replace-with-a-strong-unique-password

# Email transport
EMAIL=notifications@example.com
EMAIL_PASS=replace-with-a-mail-provider-app-password
EMAIL_TIME=1h
PASS_TIME=1h

# Optional Gemini integration; keep empty to disable the public AI feature.
GEMINI_API_KEY_1=

# Retained only for possible future use; MongoDB connection is currently disabled.
MONGO_URI=

# Optional/legacy application settings. Review before enabling.
IS_USER_AUTOMATICALLY_CONFIRMED=false
USERS_REMOVE_UNCONFIRMED_USERS_SCHEDULER_INTERVAL_IN_MINUTES=60
REMOVE_UNCONFIRMED_USERS_AFTER_INTERVAL_IN_HOURS=24
DB_AUTOSYNC=false
BLOGS_MAX_POSTS_COUNT_BEFORE_MODERATION=10
PAYMENTS_SUBSCRIPTION_PRICE=0
