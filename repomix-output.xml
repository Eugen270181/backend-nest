  expect(cookieWithRefreshToken).toBeDefined();
  const refreshToken: string | undefined =
    cookieWithRefreshToken?.split(';')[0].split('=')[1] || '';
  expect(refreshToken).toBeDefined();

  return { accessToken, refreshToken };
};

